# Platform adapter selector. Set to qqbot-official when using QQ official bot.
PLATFORM_ADAPTER=qqbot-official

# Local HTTP port for the bot process.
PORT=3456

# QQ official bot AppID from the QQ bot console.
QQBOT_APP_ID=

# QQ official bot AppSecret. Keep real values only in local env files.
QQBOT_APP_SECRET=

# QQ official bot OpenAPI base URL.
QQBOT_API_BASE_URL=https://api.sgroup.qq.com

# Timeout for QQ official bot OpenAPI requests, in milliseconds.
# Common values: 30000=30s, 60000=1min, 120000=2min, 3000000=50min.
QQBOT_API_TIMEOUT_MS=30000

# Transport mode: websocket actively connects to Gateway; webhook waits for public HTTPS callbacks.
QQBOT_TRANSPORT=websocket

# Local callback path used only when QQBOT_TRANSPORT=webhook.
QQBOT_WEBHOOK_PATH=/qqbot/webhook

# Whether to print raw QQBot Gateway/Webhook events for debugging.
QQBOT_RAW_EVENT_LOG_ENABLED=false
