# Platform adapter selector. Set to napcat when using NapCat / OneBot11.
PLATFORM_ADAPTER=napcat

# Local HTTP port for the bot process.
PORT=3456

# NapCat / OneBot11 HTTP endpoint.
NAPCAT_BASE_URL=http://127.0.0.1:3000

# NapCat access token. Leave empty if NapCat does not require one.
NAPCAT_TOKEN=

# Whether to print raw NapCat events for debugging.
NAPCAT_RAW_EVENT_LOG_ENABLED=false

# NapCat WebSocket ping interval in seconds.
WS_PING_INTERVAL_SECONDS=30

# Terminal summary interval for WebSocket ping statistics, in minutes.
WS_PING_SUMMARY_MINUTES=5

# Business heartbeat interval in minutes. Use 0 to disable.
HEARTBEAT_MINUTES=15

# Reconnect after this many failed heartbeats.
HEARTBEAT_FAIL_THRESHOLD=3
