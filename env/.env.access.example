# Access / identity, shared by every platform adapter.

# Preferred identity model. One person can own multiple platform accounts.
# Example:
# QQ_USERS_JSON=[{"id":"person_id","name":"Name","accounts":[{"platform":"napcat","id":"qq_number","label":"QQ"},{"platform":"qqbot-official","id":"openid","label":"QQBot"}],"primaryAccount":{"platform":"qqbot-official","id":"openid"},"fields":{}}]
QQ_USERS_JSON=

# Legacy fallback only when QQ_USERS_JSON is empty. Values become personIds directly.
QQ_USER_WHITELIST=

# Allowed QQ group IDs / group openids. Empty means no group is allowed.
QQ_GROUP_WHITELIST=

# Admin personIds or external account IDs. Both forms are accepted.
QQ_ADMIN_IDS=

# Display name used when the bot needs to mention the admin.
QQ_ADMIN_NAME=
